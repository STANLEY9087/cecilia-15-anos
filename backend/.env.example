# Ambiente — exemplo sem credenciais reais
# Copie para .env e preencha com valores locais/secretos.

# Conexão PostgreSQL (Neon ou outro provedor)
# DATABASE_URL: conexão POOLED (host com "-pooler") — usada pela aplicação.
# DIRECT_URL:   conexão DIRETA (host sem "-pooler") — usada pelas migrações.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host-sem-pooler/banco?sslmode=require"

# Porta do servidor HTTP
PORT=3000

# Origem(n) autorizada(s) no CORS (separar várias por vírgula)
# Em produção: https://seu-site.netlify.app
FRONTEND_URL="http://localhost:3000"

# Fallback da base dos links do CSV caso FRONTEND_URL não esteja definida
# SITE_URL="https://convite-cecilia.netlify.app"

# development | production | test
NODE_ENV=development
