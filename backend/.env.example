# Ambiente — exemplo sem credenciais reais
# Copie para .env e preencha com valores locais/secretos.

# Conexão PostgreSQL (Neon ou outro provedor)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Porta do servidor HTTP
PORT=3000

# Origem(n) autorizada(s) no CORS (separar várias por vírgula)
# Em produção: https://seu-site.netlify.app
FRONTEND_URL="http://localhost:3000"

# development | production | test
NODE_ENV=development
